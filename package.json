{
  "name": "actual-ltd",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:animal-posters": "node scripts/build-dither-posters.mjs",
    "build:animal-gallery": "node scripts/build-card-gallery.mjs",
    "build:scene-previews": "node scripts/build-scene-previews.mjs",
    "audit": "npm audit --audit-level=moderate && npm audit signatures",
    "check": "npm run typecheck && npm run check:security && npm run check:accessibility && node scripts/check-animal-placement.mjs && node scripts/check-animal-hover.mjs && node scripts/check-scene-loading.mjs && node scripts/check-background-overscan.mjs && node scripts/check-shark-gallery-palette.mjs && npm run check:deployment",
    "check:accessibility": "node scripts/check-accessibility.mjs",
    "check:deployment": "node scripts/check-github-deployment.mjs",
    "check:security": "node scripts/check-security.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@paper-design/shaders": "0.0.78",
    "motion": "12.43.0"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
